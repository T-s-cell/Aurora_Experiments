# 数据与缓存（大文件不入库）
data/*.npz
data/*.zip
data/cache/
# 协议小件明确入库：窗口划分、缓存序列、Z0 参照（独立复算分母与 Z0 指标所需）
!data/split_manifest.json
!data/data_cache.npz
!data/Z0__test.npz

# 预测输出（正式评测大 npz 不入库）
predictions/*
!predictions/.gitkeep

# 日志（常规运行日志不入库；审计证据日志随审计包走）
logs/*
!logs/.gitkeep

# 预检中间产物（大数组不入库；断言 JSON/小样例 .npy 明确保留）
preflight/big_*
preflight/*.npz
!preflight/.gitkeep

# 聚合验收 scratch 输出
scratch/

# 包与环境
*.tar.gz
_pack_*/
__pycache__/
*.pyc
.no_sync

# EXP-011 M48T512 子实验：输出与大件不入库（结果表/代码/协议/文本缓存 meta 入库）
repro_mm_timesx_v1/predictions/*
!repro_mm_timesx_v1/predictions/.gitkeep
repro_mm_timesx_v1/logs/*
!repro_mm_timesx_v1/logs/.gitkeep
repro_mm_timesx_v1/cache/*
!repro_mm_timesx_v1/cache/.gitkeep
repro_mm_timesx_v1/preflight/big_*
repro_mm_timesx_v1/preflight/*.npz
!repro_mm_timesx_v1/preflight/.gitkeep

# vendored exp004/common.py 的 import 副作用目录（见 reference/README.md）
reference/exp004/audit/
reference/exp004/checkpoints/
reference/exp004/dataset/
reference/exp004/logs/
reference/exp004/manifests/
reference/exp004/predictions/
reference/exp004/results/*
!reference/exp004/results/overall.csv

# analysis/text_budget_v1: bulk per-window traces stay out of git (results/ tables are tracked)
analysis/text_budget_v1/outputs/*
!analysis/text_budget_v1/outputs/.gitkeep

# EXP-D2 (repro-mm-timesx-d2): outputs and bulk files stay out of git
repro_mm_timesx_d2/predictions/*
!repro_mm_timesx_d2/predictions/.gitkeep
repro_mm_timesx_d2/logs/*
!repro_mm_timesx_d2/logs/.gitkeep
repro_mm_timesx_d2/cache/*
!repro_mm_timesx_d2/cache/.gitkeep
repro_mm_timesx_d2/preflight/big_*
repro_mm_timesx_d2/preflight/*.npz
repro_mm_timesx_d2/preflight/scratch_shards/
!repro_mm_timesx_d2/preflight/.gitkeep
